[Unit]
Description=ZeNis Backend (FastAPI)
After=network.target zenis-wifi.service
Wants=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/zenis/backend
ExecStart=/opt/zenis/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
